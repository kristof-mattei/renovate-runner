{
    "name": "renovate-runner",
    "type": "module",
    "scripts": {
        "format": "oxfmt",
        "prepare": "husky"
    },
    "devDependencies": {
        "husky": "9.1.7",
        "lint-staged": "17.6.2",
        "oxfmt": "0.79.0"
    },
    "lint-staged": {
        "*": [
            "oxfmt --check --no-error-on-unmatched-pattern --"
        ],
        "*.sh": [
            "shfmt --diff",
            "shellcheck"
        ]
    },
    "engines": {
        "node": "26.13.1"
    },
    "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
