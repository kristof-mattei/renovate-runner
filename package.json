{
    "name": "renovate-runner",
    "type": "module",
    "scripts": {
        "format": "oxfmt",
        "prepare": "husky"
    },
    "devDependencies": {
        "husky": "9.1.7",
        "lint-staged": "17.6.0",
        "oxfmt": "0.73.0"
    },
    "lint-staged": {
        "*": [
            "oxfmt --check --no-error-on-unmatched-pattern --"
        ],
        "*.sh": [
            "shfmt --diff",
            "shellcheck"
        ]
    },
    "engines": {
        "node": "26.12.0"
    },
    "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
