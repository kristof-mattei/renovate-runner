{
    "name": "renovate-runner",
    "type": "module",
    "scripts": {
        "format": "oxfmt",
        "prepare": "husky"
    },
    "devDependencies": {
        "husky": "9.1.7",
        "lint-staged": "17.6.0",
        "oxfmt": "0.76.0"
    },
    "lint-staged": {
        "*": [
            "oxfmt --check --no-error-on-unmatched-pattern --"
        ],
        "*.sh": [
            "shfmt --diff",
            "shellcheck"
        ]
    },
    "engines": {
        "node": "26.13.0"
    },
    "packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d"
}
